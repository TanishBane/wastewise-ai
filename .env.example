# ==============================================================================
# WasteWise AI — Environment Configuration Template
# Copy this file to .env.local (frontend) and .env (backend).
# NEVER commit actual secrets, JWT keys, or database passwords to source control.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Environment Variables (Vite / Vercel)
# Safe to expose to the client browser (prefixed with VITE_)
# ------------------------------------------------------------------------------
# Backend API Base URL (empty for same-origin/local proxy; set to Render URL in Vercel)
# Example for production: https://wastewise-api.onrender.com
VITE_API_BASE_URL=

# Supabase Project URL (e.g. https://your-project-ref.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Publishable / Anon Key (Safe for browser clients)
# Retrieve from: Supabase Dashboard -> Project Settings -> API -> Project API Keys
VITE_SUPABASE_PUBLISHABLE_KEY=sbp_your-publishable-key-here

# Legacy Anon Key fallback (supported for existing projects)
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# Backend Environment Variables (FastAPI / Render / Railway)
# Server-side ONLY: Never expose to browser clients
# ------------------------------------------------------------------------------
# Allowed CORS origins (comma-separated, without trailing slashes)
# Example: http://127.0.0.1:3000,http://localhost:3000,https://wastewise.vercel.app
WASTEWISE_CORS_ORIGINS=https://wastewise.vercel.app,http://127.0.0.1:3000,http://localhost:3000

# Supabase Project URL (for JWT issuer validation)
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase JWT Secret (for verifying HS256 access token signatures)
# Retrieve from: Supabase Dashboard -> Project Settings -> API -> JWT Settings -> JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret-here

# Algorithm used for token verification ('HS256' for HMAC secret, 'RS256' for JWKS)
SUPABASE_AUTH_ALGORITHM=HS256

# Whether to strictly require authenticated Bearer tokens on protected endpoints
# Defaults to 'true' (fail closed in staging and production).
AUTH_REQUIRED=true

# Supabase PostgreSQL Database Connection String
# Retrieve from: Supabase Dashboard -> Project Settings -> Database -> Connection String (URI)
# Use Transaction Pooler (port 6543) or Session Mode (port 5432)
DATABASE_URL=postgresql://postgres.your-project-ref:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Local SQLite fallback path (used only when DATABASE_URL is not set)
# On Render without PostgreSQL, this MUST point to a persistent disk mount (e.g., /data/wastewise.db)
WASTEWISE_DB_PATH=data/wastewise.db

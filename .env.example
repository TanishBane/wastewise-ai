# ==============================================================================
# Frontend Environment Variables (Vercel)
# ==============================================================================
# Set this in Vercel to point to your Render backend deployment.
# This is safe to expose to the client browser.
VITE_API_BASE_URL=https://wastewise-api.onrender.com

# ==============================================================================
# Backend Environment Variables (Render)
# ==============================================================================
# Allowed CORS origins (e.g., your Vercel frontend URL).
# Must NOT contain a trailing slash.
WASTEWISE_CORS_ORIGINS=https://wastewise.vercel.app

# Path to the SQLite database.
# On Render, this MUST point to a persistent disk mount (e.g., /data).
WASTEWISE_DB_PATH=/data/wastewise.db

# ==============================================================================
# WasteWise AI — Environment Configuration Template
# Public Demonstration Mode (Default)
# Zero external database or Supabase configuration required.
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend Environment Variables (Vite / Vercel)
# ------------------------------------------------------------------------------
# Backend API Base URL (empty string for same-origin or local proxy)
# Example for production: https://wastewise-api.onrender.com
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# Backend Environment Variables (FastAPI / Render / Railway)
# ------------------------------------------------------------------------------
# Public demo mode (defaults to true; provides anonymous public exploration of demo canteen)
WASTEWISE_DEMO_MODE=true

# Allowed CORS origins (comma-separated, without trailing slashes)
WASTEWISE_CORS_ORIGINS=https://waste-wiseailive.vercel.app,http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:4173,http://localhost:4173

# Optional: Enable Swagger/OpenAPI docs in demo mode (default: false for clean product presentation)
ENABLE_API_DOCS=false

# SQLite database storage path (defaults to local data/wastewise.db)
WASTEWISE_DB_PATH=data/wastewise.db

# Optional durable PostgreSQL connection string (only if connecting to an external DB)
# DATABASE_URL=

# ------------------------------------------------------------------------------
# Observability (Optional)
# ------------------------------------------------------------------------------
# Sentry DSN for frontend browser error telemetry
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# PostHog analytics (optional)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Sentry DSN for backend error telemetry
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
